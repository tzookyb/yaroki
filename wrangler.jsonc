{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plants-tracker",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "plants-tracker",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "plants-tracker-photos"
    }
  ],
  "ratelimits": [
    {
      // Per Cloudflare location, on the login route only.
      "name": "LOGIN_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "triggers": {
    // Cron runs in UTC. 06:00 UTC is 08:00/09:00 in Asia/Jerusalem.
    // Keep in sync with the switch in worker/index.ts.
    "crons": ["0 6 * * *", "0 7 * * 0"]
  }
}
