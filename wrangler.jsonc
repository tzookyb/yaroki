{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yaroki",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Sentry needs AsyncLocalStorage.
  "compatibility_flags": ["nodejs_als"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": { "enabled": true },
  // D1 and R2 keep their names from before the app was renamed to yaroki.
  // They can't be renamed in place, and the names are also in package.json
  // and scripts/pull-prod.mjs.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "plants-tracker",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "plants-tracker-photos",
    },
  ],
  "ratelimits": [
    {
      // Per Cloudflare location, on the login route only.
      "name": "LOGIN_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "triggers": {
    // Cron runs in UTC. The hourly run sends the watering reminder at the learned hour,
    // and does the once-a-day jobs at 06:00 UTC (08:00/09:00 in Asia/Jerusalem).
    // Keep in sync with the switch in worker/index.ts.
    "crons": ["0 * * * *", "0 7 * * SUN", "0 */3 * * *"],
  },
}
